# Copy to .env (gitignored) and `source` it. Nothing here is a real credential.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Account identifier is <ORGANIZATION>-<ACCOUNT>, from Snowsight's account details.
SNOWFLAKE_ORGANIZATION=your_org
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_DATABASE=MERCHANT_DISBURSEMENT

# Admin service user: Terraform and `python -m ops.deploy`
SNOWFLAKE_ADMIN_USER=TF_SERVICE_USER
SNOWFLAKE_ADMIN_PRIVATE_KEY_PATH=~/.ssh/snowflake_tf.p8

# Loader service user: the file writer and `python -m ops.verify_bronze`
SNOWFLAKE_LOADER_USER=LOADER_SERVICE_USER
SNOWFLAKE_LOADER_PRIVATE_KEY_PATH=~/.ssh/snowflake_loader.p8

# dbt (gold) uses the admin user above. Optional: a different warehouse for dbt and verify_gold.
# SNOWFLAKE_TRANSFORM_WAREHOUSE=TRANSFORM_WH
